{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": ["**", "!!dist", "!!node_modules", "!!package-lock.json"]
  },
  "linter": {
    "rules": { "preset": "recommended" },
    "domains": { "react": "recommended" }
  },
  "formatter": {
    "indentStyle": "space"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
